/* Wide enough for the equation toolbar without it wrapping; narrower screens get what fits. */
.cc-eqneditor-dropdown {
	padding: 10px 12px;
	width: 850px;
	max-width: calc(100vw - 32px);
	box-sizing: border-box;
}
